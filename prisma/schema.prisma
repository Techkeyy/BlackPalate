// Prisma Schema for BlackPalate (Neon Hosted PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id          String     @id @default(cuid())
  flynetId    String?    @unique
  name        String
  cuisine     String[]
  neighborhood String?
  priceTier   Int?       @default(2)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  campaigns   Campaign[]
}

model Campaign {
  id                  String               @id @default(cuid())
  title               String
  description         String
  dishFocus           String
  restaurantId        String
  restaurant          Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  targetCuisines      String[]
  minTotalCheckIns    Int                  @default(1)
  minCuisineVisits    Int                  @default(0)
  mustBeNewToVenue    Boolean              @default(false)
  rewardFly           String               @default("5") // Display whole FLY
  rewardFlyWei        String?              // 18-decimal wei string for Flynet /issue_reward
  maxSlots            Int                  @default(10)
  filledSlots         Int                  @default(0)
  status              String               @default("ACTIVE") // DRAFT, ACTIVE, PAUSED, COMPLETED
  feedbackQuestions   Json                 // Array of questions [{ id, prompt, type, options }]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  applications        Application[]
  feedbackSubmissions FeedbackSubmission[]
  synthesisReports    SynthesisReport[]
}

model Application {
  id                 String              @id @default(cuid())
  campaignId         String
  campaign           Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  dinerFlynetId      String
  dinerName          String?
  dinerAvatar        String?
  qualificationProof Json?               // Breakdown of how diner met criteria
  status             String              @default("QUALIFIED") // QUALIFIED, ATTENDED, SUBMITTED, REWARDED, REJECTED
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  feedback           FeedbackSubmission?
  rewardReceipt      RewardReceipt?

  @@unique([campaignId, dinerFlynetId])
}

model FeedbackSubmission {
  id             String      @id @default(cuid())
  applicationId  String      @unique
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  campaignId     String
  campaign       Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  dinerFlynetId  String
  overallScore   Int         // 1 to 5
  ratings        Json        // { flavor: 5, presentation: 4, value: 4, portion: 5 }
  answers        Json        // { [questionId]: answer }
  dishFeedback   String
  suggestions    String?
  submittedAt    DateTime    @default(now())
}

model RewardReceipt {
  id             String      @id @default(cuid())
  applicationId  String      @unique
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  campaignId     String
  dinerFlynetId  String
  amountFly      String
  amountFlyWei   String
  txHash         String?
  idempotencyKey String      @unique
  status         String      @default("PENDING") // PENDING, ISSUED, FAILED
  issuedAt       DateTime?
  error          String?
}

model SynthesisReport {
  id                 String   @id @default(cuid())
  campaignId         String
  campaign           Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  executiveSummary   String
  flavorAnalysis     String
  cohortTrends       Json     // Breakdown of responses by diner experience level
  recommendations    String[]
  rawSubmissionCount Int
  generatedAt        DateTime @default(now())
}

