# ==============================================================================
# BlackPalate Environment Configuration Template (Directive 001B)
# NOTE: DO NOT COMMIT REAL SECRETS. Copy this file to .env.local for local dev.
# ==============================================================================

# Flynet Environment: 'staging' (default) or 'production'
FLYNET_ENV=staging

# Flynet Base URLs (Defaults mapped automatically if omitted)
# Staging API: https://api.staging.blackbird.xyz/flynet/v1
# Staging OAuth: https://api.staging.blackbird.xyz/oauth
NEXT_PUBLIC_FLYNET_API_BASE=https://api.staging.blackbird.xyz/flynet/v1
NEXT_PUBLIC_FLYNET_OAUTH_BASE=https://api.staging.blackbird.xyz/oauth

# Flynet API Key (Server-side secret, starts with fly_test_ for staging, fly_live_ for prod)
# Required for Discovery routes (/restaurants*, /locations*) and Reward operations (/issue_reward, /balance)
FLYNET_API_KEY=

# Flynet OAuth Credentials (From https://make.flynet.org/)
# client_id is public; client_secret is server-side secret only
NEXT_PUBLIC_FLYNET_CLIENT_ID=
FLYNET_CLIENT_SECRET=

# Stable Public OAuth Redirect URI (Must EXACTLY match registered URI in Flynet Make)
# E.g. https://<stable-blackpalate-domain>/api/auth/callback
NEXT_PUBLIC_FLYNET_REDIRECT_URI=

# Approved OAuth Scopes (Space-separated): read:profile read:user_checkins read:wallets
NEXT_PUBLIC_FLYNET_SCOPES="read:profile read:user_checkins read:wallets"

# Production Relational Database (Single hosted Postgres e.g. Neon / Supabase)
# Required for durable multi-user sessions, campaign registry, and feedback persistence.
DATABASE_URL=

# AI Synthesis Provider Configuration (DeepSeek / OpenAI)
# Note: AI only drafts and synthesizes; deterministic rules evaluate qualification
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# App Security
SESSION_SECRET=
