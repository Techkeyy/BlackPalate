# ==============================================================================
# BlackPalate Environment Configuration Template
# NOTE: DO NOT COMMIT REAL SECRETS. Copy this file to .env.local for local dev.
# ==============================================================================

# Flynet Environment: 'staging' or 'production'
FLYNET_ENV=staging

# Flynet Base URLs (Defaults mapped automatically if omitted)
# Staging: https://api.staging.blackbird.xyz/flynet/v1 (OAuth: https://api.staging.blackbird.xyz/oauth)
# Production: https://api.blackbird.xyz/flynet/v1 (OAuth: https://api.blackbird.xyz/oauth)
NEXT_PUBLIC_FLYNET_API_BASE=https://api.staging.blackbird.xyz/flynet/v1
NEXT_PUBLIC_FLYNET_OAUTH_BASE=https://api.staging.blackbird.xyz/oauth

# Flynet API Key (Server-side secret, starts with fly_test_ for staging, fly_live_ for prod)
# Required for Discovery routes (/restaurants*, /locations*) and Reward operations
FLYNET_API_KEY=

# Flynet OAuth Credentials (From https://make.flynet.org/)
# client_id is public; client_secret is server-side secret only
NEXT_PUBLIC_FLYNET_CLIENT_ID=
FLYNET_CLIENT_SECRET=
NEXT_PUBLIC_FLYNET_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Approved OAuth Scopes (Space-separated): read:profile read:user_checkins read:wallets
NEXT_PUBLIC_FLYNET_SCOPES="read:profile read:user_checkins read:wallets"

# Flynet Merchant ID / App Wallet ID (Required for Payment Intents and issuing rewards)
FLYNET_MERCHANT_ID=

# AI Provider Configuration (For campaign drafting and research feedback synthesis)
# Note: AI only drafts and synthesizes; deterministic rules evaluate eligibility
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# App Security
SESSION_SECRET=
