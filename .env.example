# BlackPalate environment template
# Copy to .env.local and provide credentials from the relevant providers.
# Never commit real credentials.

# Flynet environment: staging (default) or production
FLYNET_ENV=staging

# Server-side Flynet API key for discovery and reward operations
FLYNET_API_KEY=

# Flynet OAuth credentials from Flynet Make
# The client ID is public configuration; the client secret stays server-side.
NEXT_PUBLIC_FLYNET_CLIENT_ID=
FLYNET_CLIENT_SECRET=

# Must exactly match the URI registered in Flynet Make
NEXT_PUBLIC_FLYNET_REDIRECT_URI=https://blackpalate.vercel.app/api/auth/callback

# Space-separated scopes. The member flow needs profile and check-in history.
NEXT_PUBLIC_FLYNET_SCOPES="read:profile read:user_checkins"

# Neon Auth server configuration
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Hosted PostgreSQL connection for durable product data
DATABASE_URL=

# Optional isolated PostgreSQL connection for integration tests.
# It must differ from DATABASE_URL. Tests skip safely when it is absent.
TEST_DATABASE_URL=

# Optional drafting/synthesis providers. The core product does not require
# either key and uses deterministic templates when they are absent.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
